{
	"name": "obsidian-js-engine-plugin",
	"version": "0.4.0",
	"description": "This plugin for obsidian allows you to use and run JavaScript from within your notes.",
	"main": "main.js",
	"scripts": {
		"deps:init": "bun install",
		"dev": "vite build --mode=development --watch",
		"build": "vite build --mode=production",
		"api:build": "bun --cwd=packages/js-engine-api run build",
		"api:typecheck": "bun --cwd=packages/js-engine-api run typecheck && tsc --noEmit -p test/fixtures/js-engine-api-consumer/tsconfig.json",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"test": "LOG_TESTS=false bun test",
		"test:log": "LOG_TESTS=true bun test",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint . --report-unused-disable-directives --suppressions-location eslint-ci-suppressions.json",
		"lint:fix": "eslint . --fix --report-unused-disable-directives --suppressions-location eslint-ci-suppressions.json",
		"svelte-check": "svelte-check",
		"check": "bun run format:check && bun run typecheck && bun run typecheck:tools && bun run api:typecheck && bun run svelte-check && bun run lint && bun run test",
		"release": "lemons-automation release",
		"lint:review": "eslint . --config eslint.review.config.mjs",
		"verify": "bun run check && bun run build && bun run api:pack && lemons-automation validate",
		"package": "bun run build && bun run api:pack && lemons-automation package",
		"api:pack": "bun run api:build && bun --cwd=packages/js-engine-api pm pack --filename ../../dist/obsidian-js-engine-api.tgz",
		"typecheck:tools": "tsc --noEmit -p tsconfig.tools.json"
	},
	"keywords": [],
	"author": "Moritz Jung",
	"license": "GPL-3.0",
	"devDependencies": {
		"@codemirror/autocomplete": "^6.20.3",
		"@codemirror/language": "^6.12.3",
		"@codemirror/lint": "^6.9.7",
		"@codemirror/state": "^6.6.0",
		"@codemirror/view": "^6.43.1",
		"@happy-dom/global-registrator": "^20.10.4",
		"@lemons_dev/lemons-obsidian-plugin-automation": "https://github.com/mProjectsCode/lemons-obsidian-plugin-helpers/releases/download/automation-v0.2.9/automation-v0.2.9.tgz",
		"@sveltejs/vite-plugin-svelte": "7.1.2",
		"@tsconfig/svelte": "^5.0.8",
		"@types/bun": "1.3.14",
		"eslint": "9.39.4",
		"obsidian": "latest",
		"prettier": "3.9.4",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.56.3",
		"svelte-check": "4.6.0",
		"tslib": "^2.8.1",
		"typescript": "6.0.3",
		"vite": "8.1.3",
		"@lemons_dev/eslint-config-obsidian": "https://github.com/mProjectsCode/lemons-obsidian-plugin-helpers/releases/download/eslint-config-v0.1.5/eslint-config-v0.1.5.tgz",
		"@types/node": "25.5.0"
	},
	"dependencies": {
		"@codemirror/legacy-modes": "^6.5.3",
		"@lemons_dev/parsinom": "^0.2.1",
		"itertools-ts": "^2.5.0",
		"zod": "^4.4.3"
	},
	"packageManager": "bun@1.4.0",
	"overrides": {
		"typescript": "6.0.3",
		"typescript-eslint": "8.61.1"
	}
}
